{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "VirituraDb": "Data Source=viritura.dev.db"
  },
  "Authentication": {
    "Google": {
      "ClientId": "replace-with-env-var-Authentication__Google__ClientId",
      "ClientSecret": "replace-with-env-var-Authentication__Google__ClientSecret"
    }
  },
  "Email": {
    "Provider": "Console"
  },
  "ForwardedHeaders": {
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],
    "KnownNetworks": []
  },
  "Mcp": {
    "MaxDynamicClients": 10000,
    "UnactivatedClientLifetime": "01:00:00",
    "InactiveClientLifetime": "30.00:00:00",
    "PruningInterval": "00:30:00"
  },
  "Signaling": {
    "Hub": {
      "MaxSubscriptionsPerConnection": 32,
      "MaxTotalTopics": 4096,
      "MaxMessagesPerSecondPerConnection": 100,
      "MaxSubscribersPerTopic": 64,
      "MaxTotalConnections": 1024,
      "MaxConnectionsPerSourceIp": 32,
      "MaxMessageBytes": 16384,
      "MaxPublishPayloadBytes": 12288
    },
    "Snapshots": {
      "MaxTotalBytes": 134217728,
      "MaxRoomCount": 512,
      "IdleEviction": "1.00:00:00",
      "AbsoluteTtl": "3.00:00:00",
      "SweepInterval": "00:15:00",
      "MaxConcurrentUploads": 4,
      "MaxUploadBytesPerIpPerMinute": 67108864,
      "MaxDownloadBytesPerIpPerMinute": 268435456
    }
  },
  "DataProtection": {
    "KeysDirectory": "replace-with-env-var-DataProtection__KeysDirectory",
    "ApplicationName": "Viritura"
  },
  "RateLimits": {
    "LoginByEmailPerMinute": 10,
    "PasswordResetEmailsPerEmailPerHour": 3,
    "VerificationEmailsPerEmailPerHour": 3,
    "TwoFactorRecoveryEmailsPerEmailPerHour": 3
  },
  "Viritura": {
    "GitHub": {
      "ClientId": "replace-with-env-var-Viritura__GitHub__ClientId",
      "ClientSecret": "replace-with-env-var-Viritura__GitHub__ClientSecret",
      "AppSlug": "replace-with-env-var-Viritura__GitHub__AppSlug",
      "RedirectUri": "replace-with-env-var-Viritura__GitHub__RedirectUri",
      "FrontendBaseUrl": "replace-with-env-var-Viritura__GitHub__FrontendBaseUrl",
      "Scope": "repo read:user",
      "AllowedFrontendOrigins": [
        "https://app.viritura.com",
        "https://viritura.com",
        "https://localhost:5173",
        "http://localhost:5173"
      ]
    }
  }
}
