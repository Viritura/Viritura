# This is an inventory of keys to create in the hosting platform's production environment.
# Do not put real production values in this file or create a local api.env.
ASPNETCORE_ENVIRONMENT=Production
PORT=8080
AllowedHosts=api.viritura.com;healthcheck.railway.app

Database__Provider=Sqlite
ConnectionStrings__VirituraDb=Data Source=/var/lib/viritura/data/viritura.db
DataProtection__KeysDirectory=/var/lib/viritura/data-protection-keys
DataProtection__ApplicationName=Viritura

# Configure the exact reverse-proxy address or network used by the host.
# Example for a Docker bridge; narrow this further when the subnet is fixed.
ForwardedHeaders__KnownNetworks__0=172.16.0.0/12

Auth__RequireEmailVerification=true
Auth__WebsiteBaseUrl=https://viritura.com

Features__Authentication__GoogleLoginEnabled=false
Features__Authentication__EmailRegistrationMode=AllowList
# Add one key per invitation: Features__Authentication__EmailRegistrationAllowList__0, __1, etc.

Email__Provider=Resend
Email__Resend__ApiKey=REPLACE_WITH_SECRET
Email__Resend__From=Viritura <accounts@mail.viritura.com>
Email__Resend__ReplyTo=support@viritura.com

Viritura__GitHub__ClientId=REPLACE_WITH_SECRET
Viritura__GitHub__ClientSecret=REPLACE_WITH_SECRET
Viritura__GitHub__AppSlug=viritura
Viritura__GitHub__RedirectUri=https://api.viritura.com/github/auth/callback
Viritura__GitHub__FrontendBaseUrl=https://app.viritura.com
Viritura__GitHub__AllowedFrontendOrigins__0=https://app.viritura.com
Viritura__GitHub__AllowedFrontendOrigins__1=https://viritura.com