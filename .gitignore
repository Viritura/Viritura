# Stale tsc emit artifacts inside src/ folders (sources are .ts/.tsx; .js
# siblings break Vite import resolution and trip the lint orphan check).
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
!packages/*/src/vite-env.d.ts
!packages/*/src/**/*.config.js

test-results/
playwright-report/
