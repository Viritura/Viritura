# Shorten pnpm's virtual-store (`.pnpm/<name>`) directory names.
#
# Windows caps most path APIs at 260 chars (MAX_PATH) unless long paths are
# enabled system-wide. This repo is developed from Git worktrees under
# `…\Harmonia.worktrees\<slug>\`, which already consumes ~95 chars before
# `node_modules`. pnpm's default virtual-store dir names run ~120 chars
# (e.g. `vitest@4.1.10_@types+node@…_vite@8.2.0_…__<hash>`), pushing nested
# `package.json` paths past 260. Node's ESM subpath-imports (`#…`) resolver
# reads `package.json` without the `\\?\` long-path prefix, so it silently
# fails on over-long paths — surfacing as `ERR_PACKAGE_IMPORT_NOT_DEFINED`
# for e.g. Vitest's `#module-evaluator`.
#
# Capping the name length keeps those paths comfortably under MAX_PATH so the
# parallel-worktree workflow (and `pnpm test`) works without requiring every
# machine to opt into Windows long paths.
virtual-store-dir-max-length=60
