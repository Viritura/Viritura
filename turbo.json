{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@viritura/editor#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/engine/viritura-wasm/pkg-browser/**",
        "$TURBO_ROOT$/packages/musx-import/assets/**",
        "$TURBO_ROOT$/packages/audio/assets/**",
        "$TURBO_ROOT$/packages/format/fixtures/mnx/**",
        "$TURBO_ROOT$/packages/format/schemas/mnx-schema.json"
      ],
      "env": [
        "VIRITURA_EXTERNAL_SOUNDFONT",
        "VIRITURA_SITE",
        "VIRITURA_WASM_BUILD_HASH",
        "VITE_STRICT",
        "VITE_VIRITURA_API_BASE_URL",
        "VITE_VIRITURA_ASSET_BASE_URL",
        "VITE_VIRITURA_WEBSITE_URL"
      ]
    },
    "@viritura/website#build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/packages/musx-import/assets/**",
        "$TURBO_ROOT$/packages/audio/assets/**",
        "$TURBO_ROOT$/packages/format/schemas/mnx-schema.json"
      ],
      "env": ["VIRITURA_EXTERNAL_SOUNDFONT", "VITE_VIRITURA_API_BASE_URL", "VITE_VIRITURA_ASSET_BASE_URL"]
    },
    "@viritura/server-ui#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@viritura/ui#build-storybook": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/assets/fonts/**"],
      "outputs": ["storybook-static/**"]
    },
    "@viritura/editor#build-storybook": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/engine/viritura-wasm/pkg-browser/**",
        "$TURBO_ROOT$/packages/musx-import/assets/**",
        "$TURBO_ROOT$/packages/audio/assets/**",
        "$TURBO_ROOT$/packages/format/fixtures/mnx/**",
        "$TURBO_ROOT$/packages/format/schemas/mnx-schema.json"
      ],
      "outputs": ["storybook-static/**"]
    },
    "@viritura/editor#build-storybook:mnx": {
      "cache": false,
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/engine/viritura-wasm/pkg-browser/**",
        "$TURBO_ROOT$/packages/musx-import/assets/**",
        "$TURBO_ROOT$/packages/audio/assets/**",
        "$TURBO_ROOT$/packages/format/fixtures/mnx/**",
        "$TURBO_ROOT$/packages/format/schemas/mnx-schema.json"
      ],
      "env": ["VIRITURA_EXTERNAL_SOUNDFONT", "VIRITURA_SITE", "VIRITURA_WASM_BUILD_HASH"],
      "outputs": ["storybook-mnx-static/**"]
    },
    "mnx-viewer#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "media/viewer.js", "media/viewer.css", "media/assets/**"]
    },
    "mnx-viewer#prepare:assets": {
      "outputs": ["media/fonts/**", "media/wasm/**", "LICENSES/**", "THIRD_PARTY_NOTICES.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    }
  }
}
