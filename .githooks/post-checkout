#!/bin/sh
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-checkout' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-checkout "$@" || exit $?

# A new Git worktree has no host-visible node_modules. Container services reuse
# Docker dependency volumes, but local agents and validation commands need pnpm
# to recreate workspace links from its machine-wide content-addressed store.
[ "${3:-0}" = "1" ] || exit 0
[ -f pnpm-lock.yaml ] || exit 0

if [ -f node_modules/.pnpm/lock.yaml ] && cmp -s pnpm-lock.yaml node_modules/.pnpm/lock.yaml; then
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  printf >&2 "\n%s\n\n" "Viritura worktree setup requires Node.js 24 on PATH. Install Node.js 24 and run 'pnpm install --frozen-lockfile' in this worktree."
  exit 1
fi

printf '%s\n' "Restoring Viritura worktree dependencies from the shared pnpm store..."
if command -v pnpm >/dev/null 2>&1; then
  pnpm install --frozen-lockfile
elif command -v corepack >/dev/null 2>&1; then
  corepack pnpm install --frozen-lockfile
else
  printf >&2 "\n%s\n\n" "Viritura worktree setup requires pnpm 9. Enable Corepack and run 'pnpm install --frozen-lockfile' in this worktree."
  exit 1
fi
