#!/bin/sh
#
# Pre-push hook:
#   1. Run the complete repository lint gate. Pre-commit checks only staged
#      files; this catches whole-tree dead exports, generated-code drift, and
#      files created or changed outside the staged-file categories.
#   2. Run the Git LFS pre-push passthrough.
#
# Bypass in a pinch with:  git push --no-verify

# 1. Whole-repository lint gate.
command -v pnpm >/dev/null 2>&1 || {
  printf >&2 "\n%s\n\n" "pre-push: pnpm is required to run the repository lint gate. Install pnpm, or bypass explicitly with 'git push --no-verify'."
  exit 2
}
pnpm lint </dev/null || {
  printf >&2 "\n%s\n\n" "pre-push: 'pnpm lint' failed. Fix the reported formatting, lint, dead-code, or generated-code errors, or bypass with 'git push --no-verify'."
  exit 1
}

# 2. Git LFS passthrough.
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"
