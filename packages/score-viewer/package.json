{
  "name": "@viritura/score-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free DOM score viewer for MNX music notation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Viritura/Viritura.git",
    "directory": "packages/score-viewer"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "examples"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "echo 'PUBLISH BLOCKED: workspace deps must be bundled or published first.' && exit 1"
  },
  "dependencies": {
    "@viritura/score-engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
