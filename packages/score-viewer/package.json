{
  "name": "@viritura/score-viewer",
  "version": "0.0.0-dev",
  "description": "Framework-free DOM score viewer for MNX music notation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Viritura/Viritura.git",
    "directory": "packages/score-viewer"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@viritura/score-engine": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "homepage": "https://viritura.com/developers",
  "bugs": {
    "url": "https://github.com/Viritura/Viritura/issues"
  }
}
