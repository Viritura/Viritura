{
  "name": "@viritura/score-viewer-react",
  "version": "0.0.1",
  "private": true,
  "description": "Embeddable React score viewer components for rendering MNX music notation in the browser. Wraps @viritura/score-engine.",
  "keywords": [
    "react",
    "music",
    "notation",
    "score",
    "mnx",
    "smufl",
    "sheet-music",
    "engraving"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peteryangio/viritura.git",
    "directory": "packages/score-viewer-react"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "echo 'PUBLISH BLOCKED: @viritura/score-engine must be published first.' && exit 1"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "dependencies": {
    "@viritura/score-engine": "workspace:*",
    "@viritura/ui": "workspace:*",
    "lucide-react": "^0.577.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
