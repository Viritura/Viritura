{
  "name": "@viritura/score-viewer-react",
  "version": "0.0.0-dev",
  "description": "Embeddable React score viewer components for rendering MNX music notation in the browser. Wraps @viritura/score-engine.",
  "keywords": [
    "react",
    "music",
    "notation",
    "score",
    "mnx",
    "smufl",
    "sheet-music",
    "engraving"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Viritura/Viritura.git",
    "directory": "packages/score-viewer-react"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "@viritura/score-engine": "workspace:^",
    "@viritura/score-viewer": "workspace:^",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "homepage": "https://viritura.com/developers",
  "bugs": {
    "url": "https://github.com/Viritura/Viritura/issues"
  }
}
