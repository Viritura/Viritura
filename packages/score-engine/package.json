{
  "name": "@viritura/score-engine",
  "version": "0.0.0-dev",
  "description": "Framework-free music notation rendering kernel: MNX layout (Rust/WASM), ink-only Canvas paint, SVG, geometry queries and a playback timeline.",
  "keywords": [
    "music",
    "notation",
    "score",
    "mnx",
    "smufl",
    "wasm",
    "engraving",
    "sheet-music"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Viritura/Viritura.git",
    "directory": "packages/score-engine"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@viritura/format": "workspace:*",
    "@viritura/midi": "workspace:*",
    "@viritura/renderer": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "homepage": "https://viritura.com/developers",
  "bugs": {
    "url": "https://github.com/Viritura/Viritura/issues"
  }
}
