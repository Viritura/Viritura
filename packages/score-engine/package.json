{
  "name": "@viritura/score-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-free music notation rendering kernel: MNX layout (Rust/WASM), ink-only Canvas paint, SVG, geometry queries and a playback timeline.",
  "keywords": [
    "music",
    "notation",
    "score",
    "mnx",
    "smufl",
    "wasm",
    "engraving",
    "sheet-music"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Viritura/Viritura.git",
    "directory": "packages/score-engine"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "echo 'PUBLISH BLOCKED: workspace deps must be inlined or published first. See README.md.' && exit 1"
  },
  "dependencies": {
    "@viritura/format": "workspace:*",
    "@viritura/midi": "workspace:*",
    "@viritura/renderer": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
