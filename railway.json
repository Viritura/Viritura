{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "server/Dockerfile",
    "watchPatterns": [
      ".dockerignore",
      "server/Dockerfile",
      "server/docker-entrypoint.sh",
      "server/Directory.Build.props",
      "server/Viritura.Api/**",
      "server/Viritura.GitHub/**",
      "server/Viritura.Infrastructure/**",
      "apps/server-ui/**",
      "packages/ui/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": "30"
  }
}
