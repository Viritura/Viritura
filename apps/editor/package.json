{
  "name": "@viritura/editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preview:prod": "vite build && vite preview",
    "test": "vitest run --exclude \"src/**/*.perf.test.ts\"",
    "test:perf": "vitest run src/__tests__/noteInput.perf.test.ts src/__tests__/pagedPatchFrame.perf.test.ts src/__tests__/horizonVsPage.perf.test.ts --maxWorkers=1 --testTimeout=120000",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "storybook:mnx": "storybook dev -p 6006 -c .storybook-mnx",
    "build-storybook:mnx": "storybook build -c .storybook-mnx -o storybook-mnx-static"
  },
