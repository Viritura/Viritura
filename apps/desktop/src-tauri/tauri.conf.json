{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viritura",
  "version": "0.0.1",
  "identifier": "com.viritura.desktop",
  "build": {
    "beforeDevCommand": "pnpm -w run wasm:build && pnpm --filter @viritura/editor dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -w run wasm:build && pnpm --filter @viritura/editor build",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Viritura",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../editor/public/articulations": "articulations",
      "../../../packages/audio/assets/sounds/Shan-SGM-Pro-15.sf2": "sounds/Shan-SGM-Pro-15.sf2"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
