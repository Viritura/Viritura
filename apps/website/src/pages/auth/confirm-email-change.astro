---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readSensitiveSearchParams } from "../../routes/auth/urlSearchParams";
import { ConfirmEmailChangePage } from "../../routes/auth/ConfirmEmailChangePage";
import { findSeoRoute } from "../../seo/routeCatalog";
import { editorUrl } from "../../siteLinks";

const route = findSeoRoute("/auth/confirm-email-change");
const { uid, email, token } = readSensitiveSearchParams(Astro.url.searchParams);
---

<SiteLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.canonicalPath}
  indexable={route.indexable}
>
  <main id="top" class="route-main">
    <ConfirmEmailChangePage uid={uid} newEmail={email} token={token} appUrl={editorUrl} client:only="react">
      <section slot="fallback" class="route-loading">
        <h1>Confirm your email change</h1>
      </section>
    </ConfirmEmailChangePage>
  </main>
</SiteLayout>
