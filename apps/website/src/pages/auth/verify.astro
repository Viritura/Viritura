---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readSensitiveSearchParams } from "../../routes/auth/urlSearchParams";
import { VerifyEmailPage } from "../../routes/auth/VerifyEmailPage";
import { findSeoRoute } from "../../seo/routeCatalog";
import { editorUrl } from "../../siteLinks";

const route = findSeoRoute("/auth/verify");
const { uid, token } = readSensitiveSearchParams(Astro.url.searchParams);
---

<SiteLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.canonicalPath}
  indexable={route.indexable}
>
  <main id="top" class="route-main">
    <VerifyEmailPage uid={uid} token={token} appUrl={editorUrl} client:only="react">
      <section slot="fallback" class="route-loading">
        <h1>Verify your email</h1>
      </section>
    </VerifyEmailPage>
  </main>
</SiteLayout>
