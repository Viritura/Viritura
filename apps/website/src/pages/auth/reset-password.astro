---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { ResetPasswordPage } from "../../routes/auth/ResetPasswordPage";
import { findSeoRoute } from "../../seo/routeCatalog";
import { editorUrl } from "../../siteLinks";

const route = findSeoRoute("/auth/reset-password");
---

<SiteLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.canonicalPath}
  indexable={route.indexable}
>
  <main id="top" class="route-main">
    <ResetPasswordPage appUrl={editorUrl} client:only="react">
      <section slot="fallback" class="route-loading">
        <h1>Choose a new password</h1>
      </section>
    </ResetPasswordPage>
  </main>
</SiteLayout>

