---
import { HeroSection } from "../HeroSection";
import {
  CollaborationSection,
  CollaborationValueStrip,
  FinalCtaSection,
  InputSection,
  OpenApproachSection,
  PartsSection,
  WorkflowSection,
} from "../siteSections";
import SiteLayout from "../layouts/SiteLayout.astro";
import { editorUrl, type SiteLinks } from "../siteLinks";
import { findSeoRoute } from "../seo/routeCatalog";
import { softwareApplicationJsonLd } from "../seo/structuredData";

const links: SiteLinks = {
  app: editorUrl,
  docs: "/docs",
  github: "https://github.com/Viritura/Viritura",
};
const route = findSeoRoute("/");
const jsonLd = softwareApplicationJsonLd();
---

<SiteLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.canonicalPath}
  indexable={route.indexable}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="top" class="marketing-home">
    <HeroSection links={links} client:load />
    <CollaborationValueStrip />
    <WorkflowSection />
    <InputSection links={links} />
    <PartsSection links={links} />
    <CollaborationSection />
    <OpenApproachSection />
    <FinalCtaSection links={links} />
  </main>
</SiteLayout>
