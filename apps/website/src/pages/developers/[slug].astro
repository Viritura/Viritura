---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { docSectionHome, docSectionRouteParams, findDocPageInSection } from "../../routes/docs/docsManifest";
import { DocsPage } from "../../routes/docs/DocsPage";
import { findSeoRoute } from "../../seo/routeCatalog";
import { breadcrumbJsonLd, techArticleJsonLd } from "../../seo/structuredData";

export function getStaticPaths() {
  return docSectionRouteParams("developers");
}

const slug = Astro.params.slug ?? "";
const docPage = findDocPageInSection("developers", slug);
const home = docSectionHome("developers");
const route = findSeoRoute(docPage?.path ?? `/developers/${slug}`);
const jsonLd = [
  techArticleJsonLd(route),
  breadcrumbJsonLd([
    { name: "Viritura", path: "/" },
    { name: "Developers", path: home.path },
    { name: docPage?.title ?? route.title, path: docPage?.path ?? `/developers/${slug}` },
  ]),
];
---

<SiteLayout
  title={route.title}
  description={route.description}
  canonicalPath={route.canonicalPath}
  indexable={route.indexable}
>
  {jsonLd.map((entry) => <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  <main id="top" class="route-main docs-route">
    <DocsPage section="developers" slug={docPage?.slug ?? slug} client:load />
  </main>
</SiteLayout>
